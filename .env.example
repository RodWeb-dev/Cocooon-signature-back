# Example environment configuration file.
# Copy this file to .env and fill in the values to configure the application.

# Environment
APP_ENV=environment
FRONTEND_URL=frontend_ url

# Database
DB_NAME=database_name
DB_USER=database_user
DB_PASSWORD=database_user_password
DB_HOST=database_host

# JWT
JWT_SECRET=jwt_secret_key
JWT_EXPIRATION=time_in_seconds

# Odoo
ODOO_URL=odoo_instance_url
ODOO_DB=odoo_database_name
ODOO_USER=odoo_user_email
ODOO_UID=odoo_uid
ODOO_API_KEY=odoo_api_key

# MailPit dev only
MAILPIT_HOST=mailpit=host
MAILPIT_PORT=mailpit_port

# Brevo
BREVO_API_KEY=brevo_api_key

# Payplug
PAYPLUG_SECRET_KEY=payplug_secret_key
PAYPLUG_WEBHOOK_SECRET=payplug_webhook_secret
